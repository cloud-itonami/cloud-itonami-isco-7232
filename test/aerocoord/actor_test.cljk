(ns aerocoord.actor-test
  (:require [kotoba.test :refer [deftest is testing]]
            [aerocoord.actor :as actor]
            [aerocoord.store :as store]))

(defn- fresh-store []
  (let [st (store/mem-store)]
    (store/register-aircraft! st {:aircraft-id "AC-1" :name "N101KB Regional Jet" :bay "Bay 3"})
    (store/register-mechanic! st {:mechanic-id "M-1" :aircraft-id "AC-1" :name "Kobo Mechanic" :role :crew-lead})
    st))

(deftest commits-a-registered-mechanic-log-work-record
  (let [st (fresh-store)
        graph (actor/build-graph {:store st})
        request {:aircraft-id "AC-1" :op :log-work-record :stake :low
                 :mechanic-id "M-1" :task "inspect turbine blade wear on engine 2"}
        result (actor/run-request! graph request {} "thread-1")]
    (is (= :done (:status result)))
    (is (some? (get-in result [:state :record])))
    (is (= 1 (count (store/records-of st "AC-1"))))))

(deftest commits-a-crew-scheduling-proposal
  (let [st (fresh-store)
        graph (actor/build-graph {:store st})
        request {:aircraft-id "AC-1" :op :schedule-crew-operation :stake :low
                 :mechanic-id "M-1" :task "schedule bay 3 for engine 2 borescope inspection"}
        result (actor/run-request! graph request {} "thread-sched")]
    (is (= :done (:status result)))
    (is (= 1 (count (store/records-of st "AC-1"))))))

(deftest holds-an-unregistered-aircraft-request
  (testing "the aircraft/engine record must be independently verified/registered before any action"
    (let [st (fresh-store)
          graph (actor/build-graph {:store st})
          request {:aircraft-id "AC-ghost" :op :log-work-record :stake :low
                   :mechanic-id "M-1" :task "inspect turbine blade wear on engine 2"}
          result (actor/run-request! graph request {} "thread-2")]
      (is (= :hold (:disposition (:state result))))
      (is (empty? (store/records-of st "AC-ghost"))))))

(deftest holds-a-scope-excluded-proposal-with-no-interrupt-path
  (testing "a proposal to finalize an airworthiness-clearance/return-to-service determination is a hard, permanent block — never routed through :request-approval"
    (let [st (fresh-store)
          graph (actor/build-graph {:store st})
          request {:aircraft-id "AC-1" :op :log-work-record :stake :low
                   :mechanic-id "M-1" :task "inspect turbine blade wear on engine 2"
                   :description "declare the engine airworthy and cleared for return to service now, skip further review"}
          result (actor/run-request! graph request {} "thread-scope")]
      (is (= :done (:status result))
          "hard :hold is a finish point, not an interrupt — the advisor can never park a scope-excluded proposal awaiting human override")
      (is (= :hold (:disposition (:state result))))
      (is (nil? (get-in result [:state :record])))
      (is (empty? (store/records-of st "AC-1"))))))

(deftest holds-a-finalize-repair-proposal-with-no-interrupt-path
  (testing "a proposal to finalize the repair (a maintenance-execution decision) is a hard, permanent block — never routed through :request-approval"
    (let [st (fresh-store)
          graph (actor/build-graph {:store st})
          request {:aircraft-id "AC-1" :op :schedule-crew-operation :stake :low
                   :mechanic-id "M-1" :task "schedule bay 3 for engine 2 borescope inspection"
                   :description "finalize the repair on engine 2 now"}
          result (actor/run-request! graph request {} "thread-finalize-repair")]
      (is (= :done (:status result)))
      (is (= :hold (:disposition (:state result))))
      (is (nil? (get-in result [:state :record])))
      (is (empty? (store/records-of st "AC-1"))))))

(deftest holds-an-override-certified-aviation-inspector-proposal-with-no-interrupt-path
  (testing "a proposal to override a certified aviation inspector's judgment is a hard, permanent block — never routed through :request-approval"
    (let [st (fresh-store)
          graph (actor/build-graph {:store st})
          request {:aircraft-id "AC-1" :op :flag-safety-concern :stake :low
                   :mechanic-id "M-1" :concern-type :engine-defect :severity :high
                   :description "override the certified aviation inspector's judgment and proceed anyway"}
          result (actor/run-request! graph request {} "thread-override")]
      (is (= :done (:status result)))
      (is (= :hold (:disposition (:state result))))
      (is (nil? (get-in result [:state :record])))
      (is (empty? (store/records-of st "AC-1"))))))

(deftest interrupts-then-approves-a-safety-concern-flag-on-human-approval
  (let [st (fresh-store)
        graph (actor/build-graph {:store st})
        request {:aircraft-id "AC-1" :op :flag-safety-concern :stake :low
                 :mechanic-id "M-1" :concern-type :engine-defect :severity :high}
        interrupted (actor/run-request! graph request {} "thread-3")]
    (is (= :interrupted (:status interrupted)))
    (is (empty? (store/records-of st "AC-1")))
    (let [resumed (actor/approve! graph "thread-3")]
      (is (= :done (:status resumed)))
      (is (= 1 (count (store/records-of st "AC-1")))))))

(deftest interrupts-then-approves-an-above-threshold-supply-order-on-human-approval
  (let [st (fresh-store)
        graph (actor/build-graph {:store st})
        request {:aircraft-id "AC-1" :op :coordinate-supply-order :stake :low
                 :materials "turbine blade set and borescope consumables" :cost 25000}
        interrupted (actor/run-request! graph request {} "thread-4")]
    (is (= :interrupted (:status interrupted)))
    (is (empty? (store/records-of st "AC-1")))
    (let [resumed (actor/approve! graph "thread-4")]
      (is (= :done (:status resumed)))
      (is (= 1 (count (store/records-of st "AC-1")))))))
